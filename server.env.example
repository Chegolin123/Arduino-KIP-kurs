# Пример конфигурации сервера. Реальные значения держи в server.env (он в .gitignore).
PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=arduino_learning

# Длинный случайный секрет для подписи JWT — сгенерируй свой (например openssl rand -hex 32)
JWT_SECRET=

UPLOAD_PATH=uploads
MAIL_USER=
MAIL_PASS=
CLIENT_URL=
